# ── Database ──────────────────────────────────────────────────────────────────
# Note the +psycopg2 dialect — this is what config.py/db/session.py actually
# expect, not +asyncpg.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/adgen

# ── kie.ai — REQUIRED ──────────────────────────────────────────────────────────
# Single key for both: every agent's LLM calls, AND the Producer agent's real
# image generation (nano-banana). Get one at https://kie.ai
KIE_API_KEY=

# ── Google AI — optional, not required to run the pipeline today ─────────────
GOOGLE_API_KEY=

# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Firecrawl ─────────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
